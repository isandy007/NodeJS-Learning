<header class="bg-red-500 text-white p-4 shadow-md">
  <nav class="container mx-auto flex justify-between items-center">
    <!-- Left side navigation -->
    <ul class="flex flex-row space-x-4">
      <li>
        <a
          href="/"
          class="<%= currentPage ==='index' ? 'bg-red-400' : 'hover:bg-red-400' %> inline-block py-2 px-4 rounded transition duration-300"
        >
          airbnb
        </a>
      </li>
      <% if(isLoggedIn) { %>
      <li>
        <a
          href="/homes"
          class="<%= currentPage ==='home' ? 'bg-red-400' : 'hover:bg-red-400' %> inline-block py-2 px-4 rounded transition duration-300"
        >
          Homes-list
        </a>
      </li>

      <li>
        <a
          href="/favourites"
          class="<%= currentPage ==='favourites' ? 'bg-red-400' : 'hover:bg-red-400' %> inline-block py-2 px-4 rounded transition duration-300"
        >
          Favourites
        </a>
      </li>

      <li>
        <a
          href="/bookings"
          class="<%= currentPage ==='bookings' ? 'bg-red-400' : 'hover:bg-red-400' %> inline-block py-2 px-4 rounded transition duration-300"
        >
          Bookings
        </a>
      </li>

      <li>
        <a
          href="/host/host-home-list"
          class="<%= currentPage ==='host-homes' ? 'bg-red-400' : 'hover:bg-red-400' %> inline-block py-2 px-4 rounded transition duration-300"
        >
          Host Homes
        </a>
      </li>

      <li>
        <a
          href="/host/add-home"
          class="<%= currentPage ==='addHome' ? 'bg-red-400' : 'hover:bg-red-400' %> inline-block py-2 px-4 rounded transition duration-300"
        >
          Add Home
        </a>
      </li>
      <% } %>
    </ul>
    <!-- Right side navigation -->
    <ul class="flex">
      <% if(!isLoggedIn) { %>
      <li>
        <a
          href="/login"
          class="<%= currentPage ==='login' ? 'bg-red-400' : 'hover:bg-red-400' %> inline-block py-2 px-4 rounded transition duration-300"
        >
          Login
        </a>
      </li>
      <% } else { %>
      <form action="/logout" method="POST" class="inline-block">
        <button
          type="submit"
          class="<%= currentPage ==='logout' ? 'bg-red-400' : 'hover:bg-red-400' %> inline-block py-2 px-4 rounded transition duration-300"
        >
          Logout
        </button>
      </form>
      <% } %>
    </ul>
  </nav>
</header>
